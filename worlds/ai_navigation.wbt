#VRML_SIM R2025a utf8

EXTERNPROTO "webots://projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "webots://projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "webots://projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "webots://projects/robots/gctronic/e-puck/protos/E-puck.proto"

WorldInfo {
  basicTimeStep 32
}
Viewpoint {
  orientation 0.31 0.71 0.63 1.23
  position 0 -2.8 2.6
}
TexturedBackground {
}
TexturedBackgroundLight {
}
Floor {
  size 2.4 2.4
}
DEF ROBOT E-puck {
  translation -0.8 -0.34 0
  rotation 0 0 1 0
  controller "ai_navigation"
  supervisor TRUE
}
# Goal marker: visual only (no collision body)
DEF GOAL_MARKER Pose {
  translation 0.76 0.40 0.08
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.0 0.85 0.15
        roughness 0.3
        emissiveColor 0 0.16 0
      }
      geometry Sphere {
        radius 0.065
      }
    }
  ]
}
DEF OBSTACLE_1 Solid {
  translation -0.10 0.00 0.07
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.9 0.3 0.13
        roughness 0.8
      }
      geometry DEF BOX1 Box {
        size 0.22 0.16 0.14
      }
    }
  ]
  name "obstacle near center"
  boundingObject USE BOX1
}
DEF OBSTACLE_2 Solid {
  translation 0.34 0.24 0.06
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.2 0.4 0.9
        roughness 0.8
      }
      geometry DEF BOX2 Box {
        size 0.16 0.16 0.12
      }
    }
  ]
  name "obstacle near goal"
  boundingObject USE BOX2
}
DEF WALL_EAST Solid {
  translation 1.20 0 0.07
  children [
    DEF WALL_SHAPE Shape {
      appearance PBRAppearance {
        baseColor 0.3 0.4 0.5
        roughness 1
      }
      geometry Box {
        size 0.03 2.43 0.14
      }
    }
  ]
  boundingObject USE WALL_SHAPE
  name "east wall"
}
DEF WALL_WEST Solid {
  translation -1.20 0 0.07
  children [ USE WALL_SHAPE ]
  boundingObject USE WALL_SHAPE
  name "west wall"
}
DEF WALL_NORTH Solid {
  translation 0 1.20 0.07
  rotation 0 0 1 1.570796
  children [ USE WALL_SHAPE ]
  boundingObject USE WALL_SHAPE
  name "north wall"
}
DEF WALL_SOUTH Solid {
  translation 0 -1.20 0.07
  rotation 0 0 1 1.570796
  children [ USE WALL_SHAPE ]
  boundingObject USE WALL_SHAPE
  name "south wall"
}
